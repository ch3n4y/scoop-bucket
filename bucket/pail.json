{
    "version": "0.2.0",
    "description": "Desktop client for Amazon S3, Cloudflare R2, MinIO and other S3-compatible object storage.",
    "homepage": "https://pail.download",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/DejavuMoe/Pail/releases/download/v0.2.0/Pail-v0.2.0-windows-amd64.zip",
            "hash": "b72fc15c1d099c14d0e960795c4f0845f1a4f79dbaca29e63cf41ed41abe496d",
            "extract_dir": "Pail-v0.2.0-windows-amd64"
        },
        "arm64": {
            "url": "https://github.com/DejavuMoe/Pail/releases/download/v0.2.0/Pail-v0.2.0-windows-arm64.zip",
            "hash": "22a1aa7cf77d272867ee6b0c598d8b3fd913e275366c6d8f98b8854557d0e2d6",
            "extract_dir": "Pail-v0.2.0-windows-arm64"
        }
    },
    "pre_install": [
        "$versioned = Get-ChildItem -Path \"$dir\" -Filter '*-v*-windows-*.exe' -File",
        "$arch = if ($architecture -eq 'arm64') { 'arm64' } else { 'amd64' }",
        "foreach ($file in $versioned) {",
        "    # Upstream names executables 'pail[-desktop]-v<version>-windows-<arch>.exe'.",
        "    # Drop the version and the architecture so 'bin' and 'shortcuts' can use plain names",
        "    # that survive version bumps without being rewritten by autoupdate.",
        "    if ($file.Name -like \"*windows-$arch.exe\") {",
        "        $stem = $file.Name -replace '-v[0-9].*$', ''",
        "        Rename-Item -Path $file.FullName -NewName \"$stem.exe\"",
        "    } else {",
        "        Remove-Item -Path $file.FullName -Force",
        "    }",
        "}",
        "if (!(Test-Path \"$dir\\pail-desktop.exe\")) { error 'pail-desktop.exe not found after extraction' }"
    ],
    "bin": [
        ["pail-desktop.exe", "pail-desktop"],
        "pail.exe"
    ],
    "shortcuts": [
        ["pail-desktop.exe", "Pail"]
    ],
    "checkver": {
        "github": "https://github.com/DejavuMoe/Pail"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/DejavuMoe/Pail/releases/download/v$version/Pail-v$version-windows-amd64.zip",
                "extract_dir": "Pail-v$version-windows-amd64"
            },
            "arm64": {
                "url": "https://github.com/DejavuMoe/Pail/releases/download/v$version/Pail-v$version-windows-arm64.zip",
                "extract_dir": "Pail-v$version-windows-arm64"
            }
        },
        "hash": {
            "url": "https://github.com/DejavuMoe/Pail/releases/download/v$version/SHA256SUMS"
        }
    }
}
